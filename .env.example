# ──────────────────────────────────────────────────────────────
# Lando Ripsday store: environment variables
# Copy to .env.local for local dev; set the same keys in Vercel.
# ──────────────────────────────────────────────────────────────

# Which commerce backend to use: mock | square
COMMERCE_PROVIDER=mock

# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Square (only needed when COMMERCE_PROVIDER=square) ─────────
# Developer Dashboard → your app → Credentials
SQUARE_ACCESS_TOKEN=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
# Locations → the location whose inventory the site sells from
SQUARE_LOCATION_ID=
# Webhooks → your subscription → Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the URL registered in the webhook subscription
SQUARE_WEBHOOK_URL=https://your-domain.com/api/webhooks/square

# ── Whatnot & socials (placeholders) ───────────────────────────
NEXT_PUBLIC_WHATNOT_URL=https://www.whatnot.com/user/YOUR-WHATNOT-HANDLE
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/YOUR-HANDLE
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@YOUR-HANDLE
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@YOUR-HANDLE
